# Copy to .env and fill in. Never commit .env.

APP_NAME=Aide
ENV=dev                                   # set to prod when deployed
BASE_URL=https://your-app.onrender.com    # public HTTPS URL of the web service
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Generate once and keep safe; losing it makes stored data unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace: the workspace ID (wrkspc_...) from console > Settings > Workspaces
ANTHROPIC_WORKSPACE_ID=
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# ---- App sign-in codes (the Android app and web app are the main product) ----
# Email: resend (https://resend.com) or smtp. Leave as console in development: codes are logged.
EMAIL_PROVIDER=console
EMAIL_FROM=Aide <hello@yourdomain.in>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMS: msg91 (India; needs a DLT-approved OTP template with ##OTP##) or twilio. console in development.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push notifications to the Android app go through Expo's push service. Optional access token:
EXPO_ACCESS_TOKEN=
# Deep link scheme of the Android app (must match mobile/app.json "scheme")
APP_SCHEME=aide
# Extra origins allowed to call the API from a browser, e.g. the Expo web dev server
CORS_ORIGINS=

# ---- WhatsApp (optional, OFF by default) ----
# Meta's WhatsApp Business terms bar general-purpose AI assistants (since 15 Jan 2026), so the
# product is app-first. Leave these empty. The terminal simulator still works for development.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_REOPEN_TEMPLATE=assistant_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# Google Cloud OAuth client (Web application)
# Authorised redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web research: either key turns on web_search (read_url always works)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Voice notes: transcription (optional)
OPENAI_API_KEY=

# Secure computer (headless browser for approved web tasks)
BROWSER_ENABLED=true
BROWSER_MAX_STEPS=25

# Scheduler runs inside the web process (one service). Set false if you run app.worker.run separately.
RUN_WORKER_IN_WEB=true

# Where people download the Android app (Play Store or APK link), shown on the homepage
ANDROID_APP_URL=

# Behaviour
DEFAULT_BRIEF_HOUR=8
UNDO_WINDOW_SECONDS=60
RAW_RETENTION_DAYS=90
INITIAL_SYNC_DAYS=90
SYNC_INTERVAL_MINUTES=15
