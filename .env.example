# Copy to .env and fill in. Never commit .env.

APP_NAME=Aide
ENV=dev                                   # set to prod when deployed
BASE_URL=https://your-app.onrender.com    # public HTTPS URL of the web service
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Generate once and keep safe; losing it makes stored data unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# WhatsApp Business Platform, Cloud API (https://developers.facebook.com/apps)
# Leave WHATSAPP_TOKEN empty to use the terminal simulator instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_REOPEN_TEMPLATE=assistant_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# Google Cloud OAuth client (Web application)
# Authorised redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Behaviour
DEFAULT_BRIEF_HOUR=8
UNDO_WINDOW_SECONDS=60
RAW_RETENTION_DAYS=90
INITIAL_SYNC_DAYS=90
SYNC_INTERVAL_MINUTES=15
